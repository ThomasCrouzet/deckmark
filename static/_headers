# Clickjacking: Cloudflare Pages serves this file; GitHub Pages ignores it.
# The app ships its CSP in a meta element, and a browser ignores
# frame-ancestors from a meta element. The host must send these two headers.
# GitHub Pages needs the same values in its hosting configuration.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/*.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/edition.json
  Cache-Control: public, max-age=0, must-revalidate

/_app/version.json
  Cache-Control: public, max-age=0, must-revalidate

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
