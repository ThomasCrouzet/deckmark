{
	"name": "deckmark",
	"private": true,
	"version": "2.5.4",
	"packageManager": "npm@10.9.8",
	"description": "A local-first WYSIWYG markdown editor - offline, 100% client-side PWA. No server, no account, no telemetry.",
	"license": "MIT",
	"author": "Thomas Crouzet",
	"homepage": "https://www.deckmark.dev/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ThomasCrouzet/deckmark.git"
	},
	"bugs": {
		"url": "https://github.com/ThomasCrouzet/deckmark/issues"
	},
	"keywords": [
		"markdown",
		"editor",
		"wysiwyg",
		"pwa",
		"offline",
		"svelte",
		"sveltekit",
		"milkdown",
		"client-side",
		"note-taking"
	],
	"type": "module",
	"bin": {
		"deckmark": "bin/deckmark.mjs",
		"deckmark-mcp": "bin/deckmark-mcp.mjs"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"patch:milkdown": "node scripts/patch-milkdown-images.mjs --write",
		"patch:milkdown:check": "node scripts/patch-milkdown-images.mjs --check",
		"cli": "node bin/deckmark.mjs",
		"mcp": "node bin/deckmark-mcp.mjs",
		"cli:build": "node scripts/build-cli.mjs",
		"dev": "node scripts/patch-milkdown-images.mjs --write && vite dev",
		"build": "node scripts/build-edition.mjs web",
		"build:web": "node scripts/build-edition.mjs web",
		"build:desktop": "node scripts/build-edition.mjs desktop",
		"check:edition": "node scripts/check-edition-boundaries.mjs web",
		"preview": "vite preview --outDir build",
		"preview:pages": "node scripts/preview-pages.mjs",
		"prepare": "node scripts/prepare.mjs",
		"check": "node scripts/patch-milkdown-images.mjs --write && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:katex-assets",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:katex-assets": "node scripts/sync-katex-assets.mjs --check",
		"notices:generate": "node scripts/generate-third-party-notices.mjs",
		"notices:check": "node scripts/generate-third-party-notices.mjs --check",
		"sbom:npm": "npm sbom --sbom-format cyclonedx --package-lock-only > sbom-npm.cdx.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . && prettier --check .",
		"test": "vitest run && npm run test:ci && node scripts/verify-desktop-backup-scheduler.mjs",
		"test:benchmark-gate": "npm run test:ci",
		"test:coverage": "vitest run --coverage && npm run test:ci && node scripts/verify-desktop-backup-scheduler.mjs",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:fidelity": "playwright test source-fidelity.spec.ts",
		"test:e2e:ui": "playwright test --ui",
		"size": "size-limit && node scripts/bundle-graph.mjs && node scripts/check-precache-budget.mjs",
		"sync:katex-assets": "node scripts/sync-katex-assets.mjs",
		"analyze": "vite-bundle-visualizer",
		"benchmark:local": "node scripts/benchmark-local.mjs",
		"benchmark:stress": "node scripts/benchmark-local.mjs --suite stress",
		"clean": "node scripts/clean.mjs",
		"clean:restore": "node scripts/clean.mjs --restore",
		"tauri": "tauri",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build",
		"benchmark:modes": "node scripts/benchmark-modes.mjs",
		"benchmark:modes:audit": "node scripts/benchmark-modes-audit.mjs",
		"test:ci": "node --test --test-concurrency=1 scripts/benchmark-shared.test.mjs scripts/benchmark-modes.test.mjs scripts/benchmark-stress.test.mjs scripts/build-provenance.test.mjs scripts/check-e2e-manifest.test.mjs scripts/e2e-shards.test.mjs scripts/ci-tier.test.mjs scripts/ci-web-workflow.test.mjs scripts/manifest-id.test.mjs .github/scripts/configure-ubuntu-apt.test.mjs scripts/ci-playwright-image.test.mjs scripts/ci-changes.test.mjs scripts/desktop-changes.test.mjs scripts/ci-security-scope.test.mjs scripts/ci-security-gitleaks.test.mjs scripts/ci-security-cargo-audit.test.mjs scripts/ci-security-workflow.test.mjs scripts/ci-cli-contract.test.mjs scripts/desktop-release-policy.test.mjs scripts/collect-desktop-assets.test.mjs scripts/desktop-release-orchestration.test.mjs scripts/ci-release-coordinator.test.mjs scripts/native-smoke-process.test.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.0",
		"@size-limit/file": "14.3.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "2.12.4",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.8",
		"@types/js-yaml": "4.0.9",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "4.1.12",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.24.0",
		"fake-indexeddb": "^6.2.7",
		"fast-check": "4.10.2",
		"globals": "^17.14.0",
		"jsdom": "^26.0.0",
		"lefthook": "2.2.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"size-limit": "14.3.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.10.0",
		"tailwindcss": "^4.1.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vite-bundle-visualizer": "1.2.1",
		"vitest": "4.1.12",
		"workbox-build": "7.4.1"
	},
	"dependencies": {
		"@codemirror/autocomplete": "6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-cpp": "6.0.3",
		"@codemirror/lang-css": "6.3.1",
		"@codemirror/lang-html": "6.4.12",
		"@codemirror/lang-java": "6.0.2",
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/lang-json": "6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-php": "6.0.2",
		"@codemirror/lang-python": "6.2.1",
		"@codemirror/lang-rust": "6.0.2",
		"@codemirror/lang-sql": "6.10.0",
		"@codemirror/lang-xml": "6.1.0",
		"@codemirror/lang-yaml": "6.1.3",
		"@codemirror/language": "6.13.1",
		"@codemirror/legacy-modes": "6.5.5",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lucide/svelte": "1.70.0",
		"@milkdown/crepe": "^7.23.0",
		"@milkdown/kit": "^7.23.0",
		"@tauri-apps/api": "2.12.4",
		"@tauri-apps/plugin-dialog": "2.8.4",
		"dexie": "^4.4.7",
		"dompurify": "~3.4.15",
		"highlight.js": "~11.12.0",
		"js-yaml": "~4.3.2",
		"jszip": "~3.10.2",
		"katex": "~0.19.1",
		"marked": "~18.1.2",
		"mermaid": "~12.3.0"
	},
	"overrides": {
		"fast-uri": "3.1.9",
		"serialize-javascript": "7.1.3",
		"brace-expansion": "5.0.12",
		"lodash-es": "4.18.1",
		"minimatch": "11.0.1",
		"glob": "14.0.3",
		"postcss": {
			"nanoid": "3.3.18"
		},
		"sharp": "0.35.4",
		"katex": "$katex"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
