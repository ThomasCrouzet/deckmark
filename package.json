{
	"name": "mdsh",
	"private": true,
	"version": "2.0.1",
	"packageManager": "npm@10.9.8",
	"description": "A local-first WYSIWYG markdown editor - offline, 100% client-side PWA. No server, no account, no telemetry.",
	"license": "MIT",
	"author": "Thomas Crouzet",
	"homepage": "https://thomascrouzet.github.io/mdsh/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ThomasCrouzet/mdsh.git"
	},
	"bugs": {
		"url": "https://github.com/ThomasCrouzet/mdsh/issues"
	},
	"keywords": [
		"markdown",
		"editor",
		"wysiwyg",
		"pwa",
		"offline",
		"svelte",
		"sveltekit",
		"milkdown",
		"client-side",
		"note-taking"
	],
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"patch:milkdown": "node scripts/patch-milkdown-images.mjs --write",
		"patch:milkdown:check": "node scripts/patch-milkdown-images.mjs --check",
		"dev": "node scripts/patch-milkdown-images.mjs --write && vite dev",
		"build": "node scripts/patch-milkdown-images.mjs --write && vite build",
		"preview": "vite preview",
		"preview:pages": "node scripts/preview-pages.mjs",
		"prepare": "node scripts/prepare.mjs",
		"check": "node scripts/patch-milkdown-images.mjs --write && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:katex-assets",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:katex-assets": "node scripts/sync-katex-assets.mjs --check",
		"notices:generate": "node scripts/generate-third-party-notices.mjs",
		"notices:check": "node scripts/generate-third-party-notices.mjs --check",
		"sbom:npm": "npm sbom --sbom-format cyclonedx --package-lock-only > sbom-npm.cdx.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . && prettier --check .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"size": "size-limit && node scripts/bundle-graph.mjs && node scripts/check-precache-budget.mjs",
		"sync:katex-assets": "node scripts/sync-katex-assets.mjs",
		"analyze": "vite-bundle-visualizer",
		"benchmark:local": "node scripts/benchmark-local.mjs",
		"clean": "node scripts/clean.mjs",
		"clean:restore": "node scripts/clean.mjs --restore",
		"tauri": "tauri",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.0",
		"@size-limit/file": "14.2.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.2",
		"@tauri-apps/cli": "2.12.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.7",
		"@types/js-yaml": "4.0.9",
		"@types/node": "26.6.4",
		"@vite-pwa/sveltekit": "1.1.0",
		"@vitest/coverage-v8": "4.1.11",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.23.1",
		"fake-indexeddb": "^6.0.0",
		"fast-check": "4.10.2",
		"globals": "^17.13.0",
		"jsdom": "^26.0.0",
		"lefthook": "2.2.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"size-limit": "14.2.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.9.0",
		"tailwindcss": "^4.1.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vite-bundle-visualizer": "1.2.1",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "4.1.11"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@lucide/svelte": "1.54.0",
		"@milkdown/crepe": "^7.22.3",
		"@milkdown/kit": "^7.22.2",
		"@tauri-apps/api": "2.12.2",
		"@tauri-apps/plugin-dialog": "2.8.1",
		"dexie": "^4.4.6",
		"dompurify": "~3.4.15",
		"highlight.js": "~11.12.0",
		"js-yaml": "~4.3.2",
		"jszip": "~3.10.2",
		"katex": "~0.19.0",
		"marked": "~18.1.0",
		"mermaid": "~12.1.0"
	},
	"overrides": {
		"brace-expansion": "5.0.12",
		"cookie": "0.7.2",
		"lodash-es": "4.18.1",
		"postcss": {
			"nanoid": "3.3.18"
		},
		"sharp": "0.35.4",
		"katex": "$katex"
	}
}
